{
  "name": "@leakproof/cli",
  "version": "0.2.0",
  "description": "Find the leaks AI coding tools leave behind, in apps built with any AI tool. One command, runs locally, sends nothing.",
  "type": "module",
  "bin": {
    "leakproof": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "security",
    "secrets",
    "scanner",
    "vibe-coding",
    "lovable",
    "bolt",
    "supabase",
    "stripe",
    "cli",
    "leak",
    "privacy",
    "gdpr",
    "pipeda",
    "secret-scanner",
    "supabase-rls",
    "nextjs",
    "vite",
    "cursor",
    "claude-code",
    "codex",
    "github-action",
    "ai-generated-code"
  ],
  "author": "Hilal Zeidan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HilalZD/LeakProof.git"
  },
  "homepage": "https://github.com/HilalZD/LeakProof#readme",
  "bugs": {
    "url": "https://github.com/HilalZD/LeakProof/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "anser": "^2.3.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
