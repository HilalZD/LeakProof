{
  "name": "leakproof",
  "version": "0.0.1",
  "description": "Security scanner for apps built with AI tools (Lovable, Supabase, Stripe). Finds leaked keys and risky config before you ship.",
  "type": "module",
  "bin": {
    "leakproof": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "scanner",
    "cli",
    "secrets",
    "supabase",
    "stripe",
    "lovable"
  ],
  "author": "Hilal Zeidan",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
